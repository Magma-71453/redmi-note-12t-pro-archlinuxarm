[Unit]
Description=Pearl USB root shell on ttyGS0
Requires=pearl-usb-gadget.service
After=pearl-usb-gadget.service
[Service]
Type=simple
ExecStartPre=/bin/bash -c 'for i in $(seq 1 100); do [ -c /dev/ttyGS0 ] && exit 0; sleep 0.2; done; exit 1'
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyGS0
TTYReset=yes
TTYVHangup=yes
ExecStart=/bin/bash -i
Restart=always
RestartSec=2
[Install]
WantedBy=multi-user.target
