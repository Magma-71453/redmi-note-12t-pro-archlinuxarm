diff --git a/arch/arm64/mm/mmu.c b/arch/arm64/mm/mmu.c
index 1a5cf32a7..51e59b596 100644
--- a/arch/arm64/mm/mmu.c
+++ b/arch/arm64/mm/mmu.c
@@ -1138,6 +1138,68 @@ static inline void arm64_kfence_map_pool(void) { }
 
 #endif /* CONFIG_KFENCE */
 
+static bool __init pearl_linear_map_present(phys_addr_t phys)
+{
+	unsigned long va = (unsigned long)__phys_to_virt(phys);
+	pgd_t *pgd = pgd_offset_k(va);
+	p4d_t *p4d;
+	pud_t *pud;
+	pmd_t *pmd;
+	pte_t *pte;
+
+	if (pgd_none(*pgd) || pgd_bad(*pgd))
+		return false;
+	p4d = p4d_offset(pgd, va);
+	if (p4d_none(*p4d) || p4d_bad(*p4d))
+		return false;
+	pud = pud_offset(p4d, va);
+	if (pud_none(*pud) || pud_bad(*pud))
+		return false;
+	if (pud_leaf(*pud))
+		return true;
+	pmd = pmd_offset(pud, va);
+	if (pmd_none(*pmd) || pmd_bad(*pmd))
+		return false;
+	if (pmd_leaf(*pmd))
+		return true;
+	pte = pte_offset_kernel(pmd, va);
+	return pte_present(*pte);
+}
+
+/*
+ * PEARL-MAP: map the two normal-RAM windows that LK describes in its own
+ * FDT but that ended up without a linear mapping (buddy allocator handed
+ * them out and clear_page() faulted).  Called from map_mem(), before
+ * bootmem_init() builds the zones.
+ */
+static void __init pearl_map_known_ram(int flags)
+{
+	static const struct {
+		phys_addr_t start;
+		phys_addr_t end;
+		const char *name;
+	} ranges[] = {
+		{ 0xbf6f0000ULL, 0xbf700000ULL, "ccci-tag" },
+		{ 0xdb870000ULL, 0xed6e0000ULL, "md-rem" },
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(ranges); i++) {
+		phys_addr_t start = ranges[i].start;
+		phys_addr_t end = ranges[i].end;
+		bool before;
+
+		if (!memblock_is_region_memory(start, end - start))
+			continue;
+		before = pearl_linear_map_present(start);
+		if (!before)
+			__map_memblock(start, end, pgprot_tagged(PAGE_KERNEL), flags);
+		pr_warn("PEARL-MAP: %s %pa-%pa before=%d after=%d\n",
+			ranges[i].name, &start, &end, before,
+			pearl_linear_map_present(start));
+	}
+}
+
 static void __init map_mem(void)
 {
 	static const u64 direct_map_end = _PAGE_END(VA_BITS_MIN);
@@ -1196,6 +1258,7 @@ static void __init map_mem(void)
 		__map_memblock(start, end, pgprot_tagged(PAGE_KERNEL),
 			       flags);
 	}
+	pearl_map_known_ram(flags);
 }
 
