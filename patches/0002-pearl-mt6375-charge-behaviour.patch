+/*
+ * Stop charging the battery but keep the buck running so the system is fed from
+ * VBUS while the battery current settles to zero ("bypass" power).
+ *
+ * Measured on pearl: with a charger attached, BUCK_EN=0 leaves the phone
+ * discharging (-275 mA drawn from the battery) even though TCPM is happy,
+ * while BUCK_EN=1 + CHG_EN=0 converges to 0 uA and reports "Not charging".
+ */
+static int mt6375_tcpm_inhibit_charge(struct mt6375_chg_data *ddata)
+{
+	int ret;
+
+	ret = mt6375_chg_field_set(ddata, F_CHG_EN, 0);
+	if (!ret)
+		ret = mt6375_chg_field_set(ddata, F_BUCK_EN, 1);
+	if (ret)
+		ddata->power_fault = true;
+	return ret;
+}
