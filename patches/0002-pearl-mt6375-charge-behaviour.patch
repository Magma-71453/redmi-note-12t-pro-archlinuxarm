+/*
+ * Apply the user charge_behaviour switch. In the TCPM case the sink request is
+ * remembered, so restoring "auto" can hand the negotiated limit back.
+ */
+static int mt6375_chg_apply_charge_inhibit(struct mt6375_chg_data *ddata)
+{
+	if (!ddata->tcpm_managed)
+		return mt6375_chg_enable_charging(ddata,
+				!ddata->charge_inhibited &&
+				atomic_read(&ddata->attach));
+	if (ddata->charge_inhibited)
+		return mt6375_tcpm_inhibit_charge(ddata);
+	return mt6375_tcpm_apply_sink(ddata);
+}
